# Ensure shell scripts always have LF line endings
*.sh text eol=lf
hooks/session-start text eol=lf

# Extensionless bash helpers the skills call with `bash scripts/...`.
# Without this, core.autocrlf=true checks them out as CRLF and bash fails
# on the carriage return after `set -euo pipefail`.
skills/*/scripts/* text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.yaml text eol=lf

# Ensure the polyglot wrapper keeps LF (it's parsed by both cmd and bash)
*.cmd text eol=lf

# Common text files
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.gif binary
